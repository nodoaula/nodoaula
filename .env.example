# Variables de entorno que necesita el backend.
# Se declaran en Render, nunca en el repositorio (ADR-002, ADR-004).
# Los valores de aquí son FICTICIOS: este archivo solo dice CUÁLES hacen falta.

# Cadena JDBC del Session pooler de Supabase (ADR-005 §5).
# No uses la conexión directa: resuelve por IPv6 y Render no la admite.
# Host: aws-N-<región>.pooler.supabase.com   ·   Puerto: 5432 (modo sesión)
DATABASE_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Usuario del pooler: postgres.<referencia-del-proyecto>
DATABASE_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx

# Contraseña de la base de datos. Vive solo en las variables de Render.
DATABASE_PASSWORD=pon-aqui-la-real-en-el-proveedor

# Clave de la YouTube Data API v3 (HU202). Se crea en Google Cloud, restringida
# a esa API. Sin ella, la indexación por enlace responde "no disponible" y el
# formulario sigue funcionando a mano.
YOUTUBE_API_KEY=pon-aqui-la-clave-de-google-cloud

# Storage de Supabase, donde se guardan los PDF de los apuntes.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave secreta (sb_secret_…), no la antigua service_role. Da acceso total al
# proyecto: vive solo en las variables de Render y en tu .env local.
SUPABASE_SECRET_KEY=pon-aqui-la-clave-secreta

# Bucket privado de los apuntes: notes en producción, notes-dev en local, para
# que tus pruebas no ocupen el cupo de producción.
SUPABASE_STORAGE_BUCKET=notes-dev
